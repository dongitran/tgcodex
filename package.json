{
  "name": "tgcodex",
  "version": "0.1.3",
  "description": "Turn your Telegram groups into an AI-powered personal knowledge base. Professional CLI + beautiful TUI powered by OpenAI Codex (or Claude, Gemini, etc).",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "tgcodex": "dist/cli.js",
    "tg-codex": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=100",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm run typecheck && pnpm run test",
    "clean": "rm -rf dist .tgcodex-test*"
  },
  "keywords": [
    "telegram",
    "cli",
    "tui",
    "ai",
    "codex",
    "research",
    "groups",
    "chat-analysis",
    "ink",
    "terminal"
  ],
  "author": "Dong Tran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongitran/tgcodex.git"
  },
  "bugs": {
    "url": "https://github.com/dongitran/tgcodex/issues"
  },
  "homepage": "https://github.com/dongitran/tgcodex#readme",
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "date-fns": "^3.6.0",
    "figures": "^6.1.0",
    "ink": "^5.0.1",
    "p-limit": "^6.1.0",
    "react": "^18.3.1",
    "telegram": "^2.26.0",
    "write-file-atomic": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.2",
    "tsup": "^8.1.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "SECURITY.md"
  ]
}
